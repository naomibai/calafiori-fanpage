API_FOOTBALL_KEY=replace_with_your_api_football_key
PORT=3000
CORS_ORIGIN=https://naomibai.github.io

# 视频转写工作流（npm run video）需要的配置
# DeepSeek API Key：在 https://platform.deepseek.com 注册并充值后获取
DEEPSEEK_API_KEY=
# Cloudflare Worker 转写端点的访问令牌（与 wrangler secret TRANSCRIBE_TOKEN 一致）
TRANSCRIBE_TOKEN=
# 已部署的 Cloudflare Worker 地址，例如 https://calafiori-fixtures.你的账号.workers.dev
TRANSCRIBE_WORKER_URL=
